# home/modules/zen-browser/45-pywalfox.nix
#
# PywalZen (github.com/Axenide/PywalZen) -- Pywalfox themed for Zen. It
# is a fork of Pywalfox that keeps the add-on id (pywalfox@frewacom.org),
# so the signed AMO listing is the same extension; the fork has no signed
# releases of its own, and Zen will not load an unsigned build. Revisit if
# the fork starts publishing signed builds the AMO listing lacks.
#
# Three pieces:
#   - the add-on, force-installed from AMO
#   - the native messaging host, which reads ~/.cache/wal/colors (written
#     by `theme-set wal`) and hands it to the add-on. nixpkgs ships the
#     daemon but not the manifest `pywalfox install` would write, so one is
#     generated here and passed through nativeMessagingHosts.
#   - a theme fragment so `theme-set wal` runs `pywalfox update`
#
# Open the add-on's toolbar button once and pick Dark/Light/Auto; that
# choice is add-on storage, not declarative.
{ lib, pkgs, ... }:

let
  host = pkgs.writeShellScript "pywalfox-host" ''
    exec ${lib.getExe pkgs.pywalfox-native} start
  '';

  manifest = pkgs.writeTextDir "lib/mozilla/native-messaging-hosts/pywalfox.json" (
    builtins.toJSON {
      name = "pywalfox";
      description = "Automatically theme your browser using the colors generated by Pywal";
      path = "${host}";
      type = "stdio";
      allowed_extensions = [ "pywalfox@frewacom.org" ];
    }
  );
in
{
  programs.zen-browser = {
    nativeMessagingHosts = [ manifest ];

    policies.ExtensionSettings."pywalfox@frewacom.org" = {
      install_url = "https://addons.mozilla.org/firefox/downloads/latest/pywalfox/latest.xpi";
      installation_mode = "force_installed";
    };

    # Needed for the add-on's userChrome/userContent sheets (context
    # menus and other chrome the Theme API cannot reach).
    profiles.default.settings."toolkit.legacyUserProfileCustomizations.stylesheets" = true;
  };

  # Only wal has colours Zen cannot get from the Nix palettes; the add-on
  # reads ~/.cache/wal, which is stale under any other theme.
  my.theme.fragments.zen.reload = ''
    if [ "''${THEME_NAME:-}" = wal ]; then
      ${lib.getExe pkgs.pywalfox-native} update
    fi
  '';
}
