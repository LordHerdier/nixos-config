# modules/features/framework-kmod-fix.nix
# Workaround: current nixpkgs requires every out-of-tree kernel module to ship a
# <module>.ko.cer digest (generated by `modules_install` via kmodigest). The
# upstream framework-laptop-kmod package installs the bare .ko, so the kernel
# modules aggregator fails with "cat: extra/framework_laptop.ko.cer: No such file".
# Drop this once nixpkgs fixes the package.

{ config, lib, ... }:

let
  kernel = config.boot.kernelPackages.kernel;
in
{
  boot.extraModulePackages = lib.mkForce [
    (config.boot.kernelPackages.framework-laptop-kmod.overrideAttrs (old: {
      installPhase = ''
        runHook preInstall
        make -C ${kernel.dev}/lib/modules/${kernel.modDirVersion}/build M=$PWD \
          ${lib.escapeShellArgs old.makeFlags} INSTALL_MOD_PATH=$out modules_install
        runHook postInstall
      '';
    }))
  ];
}
