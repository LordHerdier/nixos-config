+/* the status block under bar x-coordinate cx, which must be inside the
+ * status text */
+StatusBlock *
+statusblockat(Monitor *m, double cx)
+{
+	int i, x = m->b.width - statusw(m);
+
+	for (i = 0; i < nsblocks; i++) {
+		x += drwl_font_getwidth(m->drw, sblocks[i].text);
+		if (cx < x)
+			return &sblocks[i];
+	}
+	return NULL;
+}
+
+/* width of the status text, including 2px of right padding */
+int
+statusw(Monitor *m)
+{
+	int i, w = 2;
+
+	for (i = 0; i < nsblocks; i++)
+		w += drwl_font_getwidth(m->drw, sblocks[i].text);
+	return w;
+}
