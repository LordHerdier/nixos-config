+/* Parse a status line into sblocks. Inline commands, as in dwlb:
+ *   ^fg(rrggbb[aa]) ^bg(rrggbb[aa])     colour the following text; empty
+ *                                       argument reverts to SchemeNorm
+ *   ^lm(cmd) ^mm(cmd) ^rm(cmd)          left/middle/right click region
+ *   ^us(cmd) ^ds(cmd)                   scroll up/down region
+ * A region runs until the same command with an empty argument, e.g.
+ * "^lm(foot)click me^lm()". cmd runs through /bin/sh -c and ends at the
+ * first ')'. "^^" is a literal '^'; anything else starting with '^' is
+ * drawn as is. */
+void
+setstatus(const char *s)
+{
+	static const char *const names[] = { "fg", "bg", "lm", "mm", "rm", "us", "ds" };
+	char *p = stextbuf, *end = stextbuf + sizeof(stextbuf) - 1, hex[9], *e;
+	const char *arg, *close;
+	StatusBlock *b = sblocks;
+	unsigned long v;
+	size_t i, n;
+
+	memset(b, 0, sizeof(*b));
+	b->text = p;
+	while (*s && p < end) {
+		if (s[0] == '^' && s[1] == '^') {
+			*p++ = '^';
+			s += 2;
+			continue;
+		}
+		for (i = 0; s[0] == '^' && i < LENGTH(names); i++)
+			if (!strncmp(s + 1, names[i], 2) && s[3] == '(')
+				break;
+		if (s[0] != '^' || i == LENGTH(names) || !(close = strchr(s + 4, ')'))) {
+			*p++ = *s++;
+			continue;
+		}
+		arg = s + 4;
+		n = close - arg;
+		s = close + 1;
+
+		/* end the current block's text; out of blocks, drop the command */
+		if (p > b->text) {
+			if (b + 1 == END(sblocks))
+				continue;
+			*p++ = '\0';
+			b[1] = b[0];
+			b++;
+		}
+		if (i < 2) {
+			v = 0;
+			if (n && *arg == '#')
+				arg++, n--;
+			if (n == 6 || n == 8) {
+				memcpy(hex, arg, n);
+				hex[n] = '\0';
+				v = strtoul(hex, &e, 16);
+				if (*e)
+					v = 0;
+				else if (n == 6)
+					v = v << 8 | 0xff;
+			}
+			if (i == 0)
+				b->fg = v;
+			else
+				b->bg = v;
+		} else if (n && p + n < end) {
+			memcpy(p, arg, n);
+			p[n] = '\0';
+			b->cmd[i - 2] = p;
+			p += n + 1;
+		} else {
+			b->cmd[i - 2] = NULL;
+		}
+		b->text = p;
+	}
+	*p = '\0';
+	nsblocks = b - sblocks + 1;
+}
+
+void
+spawnstatuscmd(const StatusBlock *b, int cmd)
+{
+	Arg arg = {.v = (const char *[]){ "/bin/sh", "-c", b->cmd[cmd], NULL }};
+	spawn(&arg);
+}
