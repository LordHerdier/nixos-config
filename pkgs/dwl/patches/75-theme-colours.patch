+/* Where the colours are read from, first match wins: the user's override
+ * (written by dwl-theme), then the system default. Neither existing leaves
+ * the compiled-in COL_* values alone. Each line is "name=#rrggbb". */
+static int
+colorsfile(char *buf, size_t len)
+{
+	const char *state = getenv("XDG_STATE_HOME"), *home = getenv("HOME");
+
+	if (state && *state)
+		snprintf(buf, len, "%s/dwl/colors", state);
+	else if (home && *home)
+		snprintf(buf, len, "%s/.local/state/dwl/colors", home);
+	else
+		buf[0] = '\0';
+	if (buf[0] && access(buf, R_OK) == 0)
+		return 1;
+	snprintf(buf, len, "%s", COLORS_SYSTEM);
+	return access(buf, R_OK) == 0;
+}
+
+/* Reads the colours file into colors[], sepcolors and rootcolor, then
+ * repaints what already exists: root background, client borders, bars and
+ * tray. Returns -1 when there was no file to read. */
+int
+loadcolors(void)
+{
+	struct { const char *key; uint32_t *dst[2]; } tbl[] = {
+		{ "fg",              { &colors[SchemeNorm][ColFg] } },
+		{ "surface",         { &colors[SchemeNorm][ColBg], &sepcolors[ColBg] } },
+		{ "border_inactive", { &colors[SchemeNorm][ColBorder], &sepcolors[ColBorder] } },
+		{ "muted",           { &sepcolors[ColFg] } },
+		{ "accent",          { &colors[SchemeSel][ColBg] } },
+		{ "accent_fg",       { &colors[SchemeSel][ColFg] } },
+		{ "border",          { &colors[SchemeSel][ColBorder] } },
+		{ "urgent",          { &colors[SchemeUrg][ColBorder] } },
+		{ "success",         { &successcolor } },
+	};
+	char path[PATH_MAX], line[128], key[32], hex[16];
+	unsigned int rgb;
+	size_t i;
+	FILE *f;
+	Client *c;
+	Monitor *m;
+
+	if (!colorsfile(path, sizeof(path)) || !(f = fopen(path, "r")))
+		return -1;
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, " %31[a-z_] = #%15[0-9a-fA-F]", key, hex) != 2
+				|| strlen(hex) != 6)
+			continue;
+		rgb = (unsigned int)strtoul(hex, NULL, 16);
+		rgb = rgb << 8 | 0xff;
+		if (!strcmp(key, "bg")) {
+			float bg[] = COLOR(rgb);
+			memcpy(rootcolor, bg, sizeof(rootcolor));
+			continue;
+		}
+		for (i = 0; i < LENGTH(tbl); i++) {
+			if (strcmp(key, tbl[i].key))
+				continue;
+			*tbl[i].dst[0] = rgb;
+			if (tbl[i].dst[1])
+				*tbl[i].dst[1] = rgb;
+		}
+	}
+	fclose(f);
+
+	/* Before setup() has built the scene there is nothing to repaint. */
+	if (!root_bg)
+		return 0;
+	wlr_scene_rect_set_color(root_bg, rootcolor);
+	wl_list_for_each(c, &clients, link) {
+		if (client_is_unmanaged(c))
+			continue;
+		client_set_border_color(c, (float[])COLOR(colors[
+			c == focused_client ? SchemeSel : c->isurgent ? SchemeUrg : SchemeNorm][ColBorder]));
+	}
+	/* The tray holds a pointer to colors[SchemeNorm] but paints its icons
+	 * onto a canvas filled with the old background, so rebuild that. */
+	wl_list_for_each(m, &mons, link)
+		if (m->tray)
+			tray_update(m->tray);
+	drawbars();
+	return 0;
+}
+
+/* The colours a status line can name, as ^fg(accent) rather than a hex
+ * value, so they follow loadcolors. 1-based, matching setstatus's names. */
+uint32_t
+statuscolor(int role)
+{
+	switch (role) {
+	case 1: return colors[SchemeSel][ColBg];     /* accent */
+	case 2: return sepcolors[ColFg];             /* muted */
+	case 3: return colors[SchemeUrg][ColBorder]; /* alert */
+	case 4: return successcolor;                 /* good */
+	}
+	return 0;
+}
+
+int
+sigcolors(int signo, void *data)
+{
+	(void)signo; (void)data;
+	loadcolors();
+	return 0;
+}
