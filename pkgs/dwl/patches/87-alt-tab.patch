+void
+mrucycle(const Arg *arg)
+{
+	/* Alt+Tab: step through windows in most recently focused order while
+	 * the bind's modifier is held, showing each one; releasing the modifier
+	 * (keypressmod) keeps the one shown, Escape (keypress) goes back. */
+	struct wlr_keyboard *kb;
+	Monitor *m;
+	Client *c;
+
+	if (!mru) {
+		mru = ecalloc(wl_list_length(&fstack), sizeof(*mru));
+		mrun = 0;
+		wl_list_for_each(c, &fstack, flink)
+			if (c->mon && !c->swallowedby)
+				mru[mrun++] = c;
+		if (mrun < 2) {
+			free(mru);
+			mru = NULL;
+			return;
+		}
+		/* Usually the top of the stack is the focused window and the first
+		 * step skips it; if nothing is focused (empty tag), start on it. */
+		mrusel = focused_client == mru[0] ? 0 : arg->i > 0 ? mrun - 1 : 1;
+		wl_list_for_each(m, &mons, link)
+			m->mrutags = m->tagset[m->seltags];
+		kb = wlr_seat_get_keyboard(seat);
+		mrumods = kb ? CLEANMASK(wlr_keyboard_get_modifiers(kb)) & ~WLR_MODIFIER_SHIFT : 0;
+	}
+	mrusel = ((mrusel + arg->i) % mrun + mrun) % mrun;
+	mrushow(mru[mrusel]);
+	/* Bound without a modifier there is no release to wait for */
+	if (!mrumods)
+		mruend(1);
+}
+
+void
+mruend(int commit)
+{
+	Client *c;
+	Monitor *m;
+	int i;
+
+	if (!mru)
+		return;
+	c = commit ? mru[mrusel] : mru[0];
+
+	/* Undo the previews: put every output's tags back, and the focus stack
+	 * back in its old order, so only the chosen window moves to the front. */
+	wl_list_for_each(m, &mons, link) {
+		if (m->mrutags && m->tagset[m->seltags] != m->mrutags) {
+			m->tagset[m->seltags] = m->mrutags;
+			arrange(m);
+		}
+	}
+	for (i = mrun - 1; i >= 0; i--) {
+		wl_list_remove(&mru[i]->flink);
+		wl_list_insert(&fstack, &mru[i]->flink);
+	}
+	/* focusclient() won't do this: c already has focus from the preview */
+	wl_list_remove(&c->flink);
+	wl_list_insert(&fstack, &c->flink);
+	free(mru);
+	mru = NULL;
+
+	if (c->mon) {
+		selmon = c->mon;
+		if (!VISIBLEON(c, c->mon))
+			view(&(Arg){.ui = c->tags});
+	}
+	focusclient(c, 1);
+	drawbars();
+}
+
+void
+mruremove(Client *c)
+{
+	int i, j;
+
+	if (!mru)
+		return;
+	for (i = 0; i < mrun && mru[i] != c; i++);
+	if (i == mrun)
+		return;
+	for (j = i; j < mrun - 1; j++)
+		mru[j] = mru[j + 1];
+	if (--mrun == 0) {
+		free(mru);
+		mru = NULL;
+		return;
+	}
+	if (i < mrusel)
+		mrusel--;
+	if (mrusel >= mrun)
+		mrusel = 0;
+}
+
+void
+mrushow(Client *c)
+{
+	/* Show c's tags without view(), so the previous tagset (view {0}) is
+	 * left alone until mruend() */
+	if (!c->mon)
+		return;
+	if (!VISIBLEON(c, c->mon)) {
+		c->mon->tagset[c->mon->seltags] = c->tags;
+		arrange(c->mon);
+	}
+	focusclient(c, 1);
+	drawbars();
+}
