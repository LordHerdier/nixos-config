+void
+switchxkblayout(const Arg *arg)
+{
+	/* Step the active layout (xkb group) by arg->i, wrapping. Set on one
+	 * physical keyboard, wlroots carries it to the others and the group;
+	 * with none attached, set it on the group directly */
+	struct wlr_keyboard *kb = &kb_group->wlr_group->keyboard;
+	int n = xkb_keymap_num_layouts(kb->keymap), next;
+	Keyboard *first;
+
+	if (n < 2)
+		return;
+	next = (((int)kb->modifiers.group + arg->i) % n + n) % n;
+	if (!wl_list_empty(&keyboards)) {
+		first = wl_container_of(keyboards.next, first, link);
+		kb = first->wlr_keyboard;
+	}
+	wlr_keyboard_notify_modifiers(kb, kb->modifiers.depressed,
+			kb->modifiers.latched, kb->modifiers.locked, next);
+}
