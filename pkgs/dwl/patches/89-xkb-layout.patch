+void
+xkblayoutchanged(void)
+{
+	/* Write the active layout's name (e.g. "English (Colemak)") to
+	 * $XDG_RUNTIME_DIR/dwl-xkb-layout for the status bar and every layout's
+	 * name, in index order, to dwl-xkb-layouts for dwl-settings, then run
+	 * xkblayoutcmd */
+	struct wlr_keyboard *kb = &kb_group->wlr_group->keyboard;
+	const char *name;
+	char path[PATH_MAX];
+	FILE *f;
+	xkb_layout_index_t i;
+
+	xkblayout = kb->modifiers.group;
+	name = xkb_keymap_layout_get_name(kb->keymap, xkblayout);
+	snprintf(path, sizeof(path), "%s/dwl-xkb-layout", getenv("XDG_RUNTIME_DIR"));
+	if ((f = fopen(path, "w"))) {
+		fprintf(f, "%s\n", name ? name : "");
+		fclose(f);
+	}
+	snprintf(path, sizeof(path), "%s/dwl-xkb-layouts", getenv("XDG_RUNTIME_DIR"));
+	if ((f = fopen(path, "w"))) {
+		for (i = 0; i < xkb_keymap_num_layouts(kb->keymap); i++) {
+			name = xkb_keymap_layout_get_name(kb->keymap, i);
+			fprintf(f, "%s\n", name ? name : "");
+		}
+		fclose(f);
+	}
+	spawn(&(Arg){.v = xkblayoutcmd});
+}
