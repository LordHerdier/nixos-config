+	/* Hi-res wheels (e.g. the MX Master 3S over Bluetooth) report each notch
+	 * as several partial steps, and clients that act on every event move
+	 * before the wheel reaches its detent. Sum the partial steps and pass on
+	 * only whole detents (96+ of 120 units), dropping a remainder left over from an
+	 * earlier, abandoned turn. */
+	if (event->source == WL_POINTER_AXIS_SOURCE_WHEEL && discrete) {
+		if (event->time_msec - wheeltime[o] > 250 || (wheelacc[o] ^ discrete) < 0)
+			wheelacc[o] = 0;
+		wheeltime[o] = event->time_msec;
+		wheelacc[o] += discrete;
+		/* A detent counts from 96 units: real notches total 100-130, so
+		 * demanding the full 120 misses some. */
+		steps = (abs(wheelacc[o]) + 24) / 120;
+		if (!steps)
+			return;
+		if (wheelacc[o] < 0)
+			steps = -steps;
+		wheelacc[o] -= steps * 120;
+		discrete = steps * 120;
+		delta = steps * 15.0;
+	}
+
