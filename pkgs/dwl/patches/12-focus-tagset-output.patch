From: julmajustus <julmajustus@tutanota.com>
Subject: [PATCH] ipc: focus output on set_tags

---
 dwl.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/dwl.c b/dwl.c
index 11b854f..3a25e3a 100644
--- a/dwl.c
+++ b/dwl.c
@@ -1986,6 +1986,7 @@ dwl_ipc_output_set_tags(struct wl_client *client, struct wl_resource *resource,
 	if (!ipc_output)
 		return;
 	monitor = ipc_output->mon;
+	selmon = monitor;
 
 	if (!newtags || newtags == monitor->tagset[monitor->seltags])
 		return;
