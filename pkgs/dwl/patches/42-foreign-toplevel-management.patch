+void
+ftlactivatenotify(struct wl_listener *listener, void *data)
+{
+	/* Go to the client rather than bring it here: switch its monitor to
+	 * its tags (view() picks the output tagmons[] maps them to) and focus. */
+	Client *c = wl_container_of(listener, c, ftl_activate);
+	if (c->swallowedby)
+		c = c->swallowedby;
+	if (locked || !c->mon)
+		return;
+	selmon = c->mon;
+	if (!VISIBLEON(c, c->mon))
+		view(&(Arg){.ui = c->tags});
+	focusclient(c, 1);
+}
+
+void
+ftlclosenotify(struct wl_listener *listener, void *data)
+{
+	Client *c = wl_container_of(listener, c, ftl_close);
+	client_send_close(c);
+}
+
+void
+ftlfullscreennotify(struct wl_listener *listener, void *data)
+{
+	Client *c = wl_container_of(listener, c, ftl_fullscreen);
+	struct wlr_foreign_toplevel_handle_v1_fullscreen_event *event = data;
+	setfullscreen(c, event->fullscreen);
+}
+
