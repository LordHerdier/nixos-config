+void
+shiftview(const Arg *arg)
+{
+	unsigned int n = LENGTH(tags), cur, shifted;
+
+	if (!selmon)
+		return;
+	cur = selmon->tagset[selmon->seltags] & TAGMASK;
+	if (arg->i > 0)
+		shifted = (cur << 1 | cur >> (n - 1)) & TAGMASK;
+	else
+		shifted = (cur >> 1 | cur << (n - 1)) & TAGMASK;
+	view(&(Arg){.ui = shifted});
+}
