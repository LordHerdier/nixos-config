+/* the text drawn for status block b: its ^hv() text while the pointer is
+ * over it, otherwise its own */
+const char *
+statustext(const StatusBlock *b)
+{
+	return b - sblocks == hoverblk && b->cmd[StHover] ? b->cmd[StHover] : b->text;
+}
+
+/* Expand the status block under the pointer if it has a ^hv() text and
+ * collapse the previous one, redrawing the bars when that changes. */
+void
+updatehover(void)
+{
+	struct wlr_scene_node *node;
+	struct wlr_scene_buffer *buffer;
+	StatusBlock *sb = NULL;
+	int idx;
+
+	if (!locked && !exclusive_focus && selmon &&
+		(node = wlr_scene_node_at(&layers[LyrBottom]->node, cursor->x, cursor->y, NULL, NULL)) &&
+		(buffer = wlr_scene_buffer_from_node(node)) && buffer == selmon->scene_buffer)
+		sb = statusblockat(selmon, (cursor->x - selmon->m.x) * selmon->wlr_output->scale);
+	idx = sb && sb->cmd[StHover] ? sb - sblocks : -1;
+	if (idx == hoverblk)
+		return;
+	hoverblk = idx;
+	drawbars();
+}
+
 /* width of the right-hand status text, including 2px of right padding */
