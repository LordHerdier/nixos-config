+int
+shaderapply(Monitor *m, struct wlr_output_state *state)
+{
+	/* Render the scene into a buffer of our own, then draw that onto the
+	 * output's buffer through the shader. The scene still only redraws
+	 * what changed in its buffer, but the shader pass always covers the
+	 * whole output: it samples away from each pixel (the curve, the
+	 * neighbourhood taps), so a partial redraw would leave stale edges */
+	static const GLfloat quad[] = { 0, 0, 1, 0, 0, 1, 1, 1 };
+	struct wlr_output *o = m->wlr_output;
+	struct wlr_scene_output_state_options opts = {0};
+	struct wlr_gles2_texture_attribs attribs;
+	struct wlr_render_pass *pass;
+	struct wlr_texture *tex;
+	struct wlr_buffer *buf;
+	pixman_region32_t whole;
+	int sync, ok = 0;
+
+	if (m->shader_swapchain && (m->shader_swapchain->width != o->width
+			|| m->shader_swapchain->height != o->height)) {
+		wlr_swapchain_destroy(m->shader_swapchain);
+		m->shader_swapchain = NULL;
+	}
+	/* Borrow the format of the output's own buffers: the scene already
+	 * renders into those, and a renderable modifier is never an
+	 * external-only one, so this samples as a plain GL_TEXTURE_2D */
+	if (!m->shader_swapchain && (!wlr_output_configure_primary_swapchain(o, state, &o->swapchain)
+			|| !(m->shader_swapchain = wlr_swapchain_create(alloc,
+			o->width, o->height, &o->swapchain->format)))) {
+		wlr_log(WLR_ERROR, "screen shader: can't allocate a buffer for %s", o->name);
+		shaderset(0);
+		return 0;
+	}
+
+	opts.swapchain = m->shader_swapchain;
+	if (!wlr_scene_output_build_state(m->scene_output, state, &opts))
+		return 0;
+	if (!(state->committed & WLR_OUTPUT_STATE_BUFFER))
+		return 1;
+
+	if (!wlr_output_configure_primary_swapchain(o, state, &o->swapchain)
+			|| !(buf = wlr_swapchain_acquire(o->swapchain)))
+		return 0;
+	if (!(tex = wlr_texture_from_buffer(drw, state->buffer)))
+		goto unlock;
+
+	/* Under explicit sync the scene tells KMS to wait for its own render
+	 * pass, which finishes before this one does: wait for ours instead */
+	sync = !!(state->committed & WLR_OUTPUT_STATE_WAIT_TIMELINE);
+	if (sync && !m->shader_timeline && !(m->shader_timeline =
+			wlr_drm_syncobj_timeline_create(wlr_renderer_get_drm_fd(drw))))
+		goto destroy;
+	if (!(pass = wlr_renderer_begin_buffer_pass(drw, buf,
+			&(struct wlr_buffer_pass_options){
+				.signal_timeline = sync ? m->shader_timeline : NULL,
+				.signal_point = m->shader_point + 1,
+			})))
+		goto destroy;
+
+	if (shader_reload)
+		shaderload();
+	/* The swapchain's format should rule out GL_TEXTURE_EXTERNAL_OES,
+	 * but sampling one as a 2D texture would give a black screen */
+	wlr_gles2_texture_get_attribs(tex, &attribs);
+	if (shader_prog && attribs.target != GL_TEXTURE_2D) {
+		wlr_log(WLR_ERROR, "screen shader: %s's buffer isn't a 2D texture", o->name);
+		shaderset(0);
+	}
+	if (shader_prog && shader_on) {
+		/* begin_buffer_pass has bound buf and set the viewport; wlroots
+		 * sets the rest of its GL state per draw, but expects no buffer
+		 * bound to GL_ARRAY_BUFFER, so the quad stays a client array */
+		glUseProgram(shader_prog);
+		glDisable(GL_BLEND);
+		glActiveTexture(GL_TEXTURE0);
+		glBindTexture(GL_TEXTURE_2D, attribs.tex);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+		glUniform1i(shader_tex, 0);
+		glUniform2f(shader_size, (GLfloat)buf->width, (GLfloat)buf->height);
+		glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, quad);
+		glEnableVertexAttribArray(0);
+		glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+		glDisableVertexAttribArray(0);
+		glBindTexture(GL_TEXTURE_2D, 0);
+		glUseProgram(0);
+	} else {
+		/* It failed to load or can't sample this buffer, and has turned
+		 * itself off: show this one frame unfiltered, not nothing */
+		wlr_render_pass_add_texture(pass, &(struct wlr_render_texture_options){
+			.texture = tex,
+			.blend_mode = WLR_RENDER_BLEND_MODE_NONE,
+		});
+	}
+	if (!wlr_render_pass_submit(pass))
+		goto destroy;
+
+	wlr_output_state_set_buffer(state, buf);
+	pixman_region32_init_rect(&whole, 0, 0, buf->width, buf->height);
+	wlr_output_state_set_damage(state, &whole);
+	pixman_region32_fini(&whole);
+	if (sync)
+		wlr_output_state_set_wait_timeline(state, m->shader_timeline, ++m->shader_point);
+	ok = 1;
+
+destroy:
+	wlr_texture_destroy(tex);
+unlock:
+	wlr_buffer_unlock(buf);
+	return ok;
+}
+
+GLuint
+shadercompile(GLenum type, const char *src)
+{
+	GLuint s = glCreateShader(type);
+	GLint ok;
+	char log[1024];
+
+	glShaderSource(s, 1, &src, NULL);
+	glCompileShader(s);
+	glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+	if (!ok) {
+		glGetShaderInfoLog(s, sizeof(log), NULL, log);
+		wlr_log(WLR_ERROR, "screen shader: %s shader: %s",
+				type == GL_VERTEX_SHADER ? "vertex" : "fragment", log);
+		glDeleteShader(s);
+		return 0;
+	}
+	return s;
+}
+
+void
+shaderfree(Monitor *m)
+{
+	wlr_swapchain_destroy(m->shader_swapchain);
+	m->shader_swapchain = NULL;
+	wlr_drm_syncobj_timeline_unref(m->shader_timeline);
+	m->shader_timeline = NULL;
+}
+
+void
+shaderload(void)
+{
+	/* The same contract as Hyprland's decoration:screen_shader: the
+	 * fragment shader samples `tex` at `v_texcoord`, and gets the output's
+	 * size in pixels as `fullSize`. The vertex shader has to be the same
+	 * GLSL version, so it borrows a 3xx shader's #version line; anything
+	 * else gets GLSL 100. Comments and blank lines may come before
+	 * #version, so it is the first line that starts with it */
+	static const char vert3[] =
+		"in vec2 pos;\n"
+		"out vec2 v_texcoord;\n"
+		"void main() {\n"
+		"	v_texcoord = pos;\n"
+		"	gl_Position = vec4(pos * 2.0 - 1.0, 0.0, 1.0);\n"
+		"}\n";
+	static const char vert1[] =
+		"attribute vec2 pos;\n"
+		"varying vec2 v_texcoord;\n"
+		"void main() {\n"
+		"	v_texcoord = pos;\n"
+		"	gl_Position = vec4(pos * 2.0 - 1.0, 0.0, 1.0);\n"
+		"}\n";
+	char vsrc[512], log[1024], *src = NULL, *ver;
+	GLuint vs = 0, fs = 0, prog;
+	size_t verlen;
+	long len;
+	GLint ok;
+	FILE *f;
+
+	shader_reload = 0;
+	if (shader_prog)
+		glDeleteProgram(shader_prog);
+	shader_prog = 0;
+
+	/* Read on every enable, so toggling twice picks up an edited shader */
+	if (!(f = fopen(screenshader, "r"))) {
+		wlr_log(WLR_ERROR, "screen shader: can't open %s: %s", screenshader, strerror(errno));
+		goto out;
+	}
+	if (fseek(f, 0, SEEK_END) || (len = ftell(f)) < 0 || fseek(f, 0, SEEK_SET)) {
+		fclose(f);
+		goto out;
+	}
+	src = ecalloc((size_t)len + 1, 1);
+	if (fread(src, 1, (size_t)len, f) != (size_t)len) {
+		wlr_log(WLR_ERROR, "screen shader: can't read %s", screenshader);
+		fclose(f);
+		goto out;
+	}
+	fclose(f);
+
+	for (ver = src; ver && strncmp(ver + strspn(ver, " \t"), "#version", 8);
+			ver = (ver = strchr(ver, '\n')) ? ver + 1 : NULL)
+		;
+	if (ver && strtol(ver + strspn(ver, " \t") + 8, NULL, 10) >= 300) {
+		verlen = strcspn(ver, "\r\n");
+		snprintf(vsrc, sizeof(vsrc), "%.*s\n%s", (int)verlen, ver, vert3);
+	} else {
+		snprintf(vsrc, sizeof(vsrc), "%s", vert1);
+	}
+	if (!(vs = shadercompile(GL_VERTEX_SHADER, vsrc))
+			|| !(fs = shadercompile(GL_FRAGMENT_SHADER, src)))
+		goto out;
+
+	prog = glCreateProgram();
+	glAttachShader(prog, vs);
+	glAttachShader(prog, fs);
+	glBindAttribLocation(prog, 0, "pos");
+	glLinkProgram(prog);
+	glGetProgramiv(prog, GL_LINK_STATUS, &ok);
+	if (!ok) {
+		glGetProgramInfoLog(prog, sizeof(log), NULL, log);
+		wlr_log(WLR_ERROR, "screen shader: link: %s", log);
+		glDeleteProgram(prog);
+		goto out;
+	}
+	shader_prog = prog;
+	shader_tex = glGetUniformLocation(prog, "tex");
+	shader_size = glGetUniformLocation(prog, "fullSize");
+
+out:
+	glDeleteShader(vs);
+	glDeleteShader(fs);
+	free(src);
+	if (!shader_prog)
+		shaderset(0);
+}
+
+void
+shaderset(int on)
+{
+	Monitor *m;
+
+	if (on && !wlr_renderer_is_gles2(drw)) {
+		wlr_log(WLR_ERROR, "screen shader: needs the GLES2 renderer");
+		return;
+	}
+	shader_on = on;
+	shader_reload = on;
+	/* Either way round, the screen holds pixels the scene's damage
+	 * tracking knows nothing about, so every buffer gets redrawn whole */
+	wl_list_for_each(m, &mons, link) {
+		m->shader_dirty = 1;
+		wlr_damage_ring_add_whole(&m->scene_output->damage_ring);
+		wlr_output_schedule_frame(m->wlr_output);
+	}
+}
