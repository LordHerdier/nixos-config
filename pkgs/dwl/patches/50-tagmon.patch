+Monitor *
+tagtomon(uint32_t mask)
+{
+	/* The enabled output tagmons[] maps a single tag to, if any */
+	Monitor *m;
+	unsigned int i;
+	if (!mask || (mask & (mask - 1)))
+		return NULL;
+	i = __builtin_ctz(mask);
+	if (i >= LENGTH(tagmons) || !tagmons[i])
+		return NULL;
+	wl_list_for_each(m, &mons, link)
+		if (m->wlr_output->enabled && !strcmp(m->wlr_output->name, tagmons[i]))
+			return m;
+	return NULL;
+}
