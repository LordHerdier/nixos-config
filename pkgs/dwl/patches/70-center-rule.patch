diff --git a/dwl.c b/dwl.c
index e75e30e..ba4058b 100644
--- a/dwl.c
+++ b/dwl.c
@@ -285,6 +285,7 @@ typedef struct {
 	const char *title;
 	uint32_t tags;
 	int isfloating;
+	int iscentered;
 	int isterm;
 	int noswallow;
 	float opacity;
@@ -595,7 +596,7 @@ applyrules(Client *c)
 	/* rule matching */
 	const char *appid, *title;
 	uint32_t newtags = 0;
-	int i;
+	int i, iscentered = 0;
 	const Rule *r;
 	Monitor *mon = selmon, *m;
 
@@ -608,6 +609,7 @@ applyrules(Client *c)
 		if ((!r->title || strstr(title, r->title))
 				&& (!r->id || strstr(appid, r->id))) {
 			c->isfloating = r->isfloating;
+			iscentered = r->iscentered;
 			c->opacity = r->opacity;
 			newtags |= r->tags;
 			c->isterm = r->isterm;
@@ -627,6 +629,12 @@ applyrules(Client *c)
 		if (p)
 			swallow(c, p);
 	}
+	/* Place before setmon(), whose resize() would otherwise leave the
+	 * client at the origin the surface reported. */
+	if (iscentered && c->isfloating && mon) {
+		c->geom.x = mon->w.x + (mon->w.width - c->geom.width) / 2;
+		c->geom.y = mon->w.y + (mon->w.height - c->geom.height) / 2;
+	}
 	setmon(c, mon, newtags);
 }
 
