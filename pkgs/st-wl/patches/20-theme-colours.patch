 	return 0;
 }
 
+/* Theme colours: lines of "INDEX #rrggbb" (terminal colour indices, 258/259
+ * being the default background/foreground) read from
+ * $XDG_STATE_HOME/theme/active/st-colors, at startup and again on SIGUSR1.
+ * Anything missing or malformed keeps the compiled-in colours. */
+static volatile sig_atomic_t reloadcolors;
+
+static void
+usr1handler(int sig)
+{
+	(void)sig;
+	reloadcolors = 1;
+}
+
+static void
+loadcolorsfile(void)
+{
+	char path[PATH_MAX], line[128], hex[32];
+	const char *state = getenv("XDG_STATE_HOME"), *home = getenv("HOME");
+	int idx;
+	FILE *f;
+
+	if (state && *state)
+		snprintf(path, sizeof(path), "%s/theme/active/st-colors", state);
+	else if (home && *home)
+		snprintf(path, sizeof(path), "%s/.local/state/theme/active/st-colors", home);
+	else
+		return;
+
+	if (!(f = fopen(path, "r")))
+		return;
+	while (fgets(line, sizeof(line), f))
+		if (sscanf(line, "%d %31s", &idx, hex) == 2)
+			xsetcolorname(idx, hex);
+	fclose(f);
+}
+
 static int wlloadfont(Font *f, FcPattern *pattern, int type, int fontsize)
 {
 	FcPattern *configured=NULL;
